@@ -1,7 +1,28 @@
-from app.auth import login
+from app.auth import limiter, login
 from tests.helpers import make_request
 
 
 def test_login_ok():
     resp = login(make_request("ana@example.com", "correct horse"))
     assert resp.status == 200
+
+
+def test_login_returns_429_after_five_failed_attempts():
+    for _ in range(5):
+        login(make_request("ana@example.com", "wrong", ip="10.0.0.7"))
+    resp = login(make_request("ana@example.com", "correct horse", ip="10.0.0.7"))
+    assert resp.status == 429
+
+
+def test_429_response_has_retry_after_header():
+    for _ in range(5):
+        login(make_request("bo@example.com", "wrong", ip="10.0.0.8"))
+    resp = login(make_request("bo@example.com", "wrong", ip="10.0.0.8"))
+    assert int(resp.headers["Retry-After"]) > 0
+
+
+def test_successful_login_resets_failed_attempts():
+    for _ in range(4):
+        login(make_request("cy@example.com", "wrong", ip="10.0.0.9"))
+    login(make_request("cy@example.com", "correct horse", ip="10.0.0.9"))
+    assert not limiter.is_blocked("10.0.0.9")
