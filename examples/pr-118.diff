 """Login handling for the demo web app."""
 
+from app import settings
 from app.http import Response
+from app.ratelimit import FailedLoginLimiter
 from app.users import check_password
 
+limiter = FailedLoginLimiter(settings.LOGIN_MAX_ATTEMPTS, settings.LOGIN_WINDOW_SECONDS)
+
 
 def login(request):
+    ip = request.remote_addr
+    if limiter.is_blocked(ip):
+        return Response(429, {"error": "too many failed login attempts"},
+                        headers={"Retry-After": str(limiter.retry_after(ip))})
     user = check_password(request.form["email"], request.form["password"])
     if user is None:
+        limiter.record_failure(ip)
         return Response(401, {"error": "invalid credentials"})
+    limiter.reset(ip)
     return Response(200, {"session": user.new_session()})
diff --git a/app/ratelimit.py b/app/ratelimit.py
new file mode 100644
index 0000000..536d6be
--- /dev/null
+++ b/app/ratelimit.py
@@ -0,0 +1,30 @@
+"""Sliding-window counter of failed login attempts per client IP."""
+
+import time
+
+
+class FailedLoginLimiter:
+    def __init__(self, max_attempts, window_seconds, clock=time.monotonic):
+        self.max_attempts = max_attempts
+        self.window_seconds = window_seconds
+        self.clock = clock
+        self._failures = {}
+
+    def record_failure(self, ip):
+        now = self.clock()
+        recent = [t for t in self._failures.get(ip, []) if now - t < self.window_seconds]
+        recent.append(now)
+        self._failures[ip] = recent
+
+    def is_blocked(self, ip):
+        now = self.clock()
+        recent = [t for t in self._failures.get(ip, []) if now - t < self.window_seconds]
+        return len(recent) >= self.max_attempts
+
+    def retry_after(self, ip):
+        """Seconds until the oldest failure in the window expires."""
+        oldest = min(self._failures.get(ip, [self.clock()]))
+        return max(0, int(self.window_seconds - (self.clock() - oldest)) + 1)
+
+    def reset(self, ip):
+        self._failures.pop(ip, None)
