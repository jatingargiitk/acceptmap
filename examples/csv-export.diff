@@ -1,5 +1,17 @@
 import { Row } from "./db";
 
 export function toCsvLine(row: Row): string {
-  return Object.values(row).map(String).join(",");
+  return Object.values(row).map(quoteCsvField).join(",");
+}
+
+// Fields with commas, quotes or newlines are wrapped in double quotes.
+export function quoteCsvField(value: unknown): string {
+  const s = String(value);
+  return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+}
+
+export function exportCsv(rows: Row[]): string {
+  if (rows.length === 0) return "";
+  const header = Object.keys(rows[0]).join(",");
+  return [header, ...rows.map(toCsvLine)].join("\n");
 }
